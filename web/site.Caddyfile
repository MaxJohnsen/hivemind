# Serves the built landing page. TLS ends at the server's own Caddy in front of this one.
:80 {
	root * /srv
	try_files {path} /site.html
	file_server
	header {
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
	}
	# Built files have a hash in their name, so they never change.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@pages not path /assets/*
	header @pages Cache-Control no-cache
}
